 const STT_CONFIRM_CALLBACK_PREFIX: &str = "sttcf";
 const STT_CONFIRM_ID_HEX_LEN: usize = 32;
+const HERDR_SCREEN_CALLBACK_DATA: &str = "herdr:screen";
+const HERDR_COMPLETION_POLL_SECONDS: u64 = 3;
+const HERDR_COMPLETION_SETTLE_SECONDS: u64 = 5;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct HerdrCompletionConfig {
+    chat_id: ChatId,
+    minimum_duration: std::time::Duration,
+}
+
+#[derive(Default)]
+struct HerdrCompletionCycle {
+    target: Option<String>,
+    working_since: Option<std::time::Instant>,
+    settled_since: Option<std::time::Instant>,
+    cokacdir_owned: bool,
+}
+
+impl HerdrCompletionCycle {
+    fn observe(
+        &mut self,
+        target: &str,
+        status: &str,
+        cokacdir_owned: bool,
+        now: std::time::Instant,
+    ) -> Option<(std::time::Duration, bool)> {
+        if self.target.as_deref() != Some(target) {
+            self.target = Some(target.to_string());
+            self.working_since = None;
+            self.settled_since = None;
+            self.cokacdir_owned = false;
+        }
+
+        match status.to_ascii_lowercase().as_str() {
+            "working" => {
+                self.working_since.get_or_insert(now);
+                self.settled_since = None;
+                self.cokacdir_owned |= cokacdir_owned;
+                None
+            }
+            "blocked" => {
+                self.settled_since = None;
+                None
+            }
+            "idle" | "done" => {
+                let started = self.working_since?;
+                let settled = self.settled_since.get_or_insert(now);
+                if now.saturating_duration_since(*settled)
+                    < std::time::Duration::from_secs(HERDR_COMPLETION_SETTLE_SECONDS)
+                {
+                    return None;
+                }
+                self.working_since = None;
+                self.settled_since = None;
+                let owned = std::mem::take(&mut self.cokacdir_owned);
+                Some((now.saturating_duration_since(started), owned))
+            }
+            _ => {
+                self.working_since = None;
+                self.settled_since = None;
+                self.cokacdir_owned = false;
+                None
+            }
+        }
+    }
+}
+
+fn herdr_completion_config_from_values(
+    chat_id: Option<&str>,
+    minimum_seconds: Option<&str>,
+) -> Result<Option<HerdrCompletionConfig>, String> {
+    let Some(chat_id) = chat_id.map(str::trim).filter(|value| !value.is_empty()) else {
+        return Ok(None);
+    };
+    let chat_id = chat_id
+        .parse::<i64>()
+        .ok()
+        .filter(|value| *value != 0)
+        .ok_or_else(|| {
+            "COKAC_HERDR_COMPLETION_NOTIFY_CHAT_ID must be a non-zero integer.".to_string()
+        })?;
+    let minimum_seconds = minimum_seconds
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+        .unwrap_or("300")
+        .parse::<u64>()
+        .map_err(|_| {
+            "COKAC_HERDR_COMPLETION_NOTIFY_MIN_S must be a non-negative integer.".to_string()
+        })?;
+    Ok(Some(HerdrCompletionConfig {
+        chat_id: ChatId(chat_id),
+        minimum_duration: std::time::Duration::from_secs(minimum_seconds),
+    }))
+}
+
+fn herdr_completion_config() -> Result<Option<HerdrCompletionConfig>, String> {
+    let chat_id = std::env::var("COKAC_HERDR_COMPLETION_NOTIFY_CHAT_ID").ok();
+    let minimum = std::env::var("COKAC_HERDR_COMPLETION_NOTIFY_MIN_S").ok();
+    herdr_completion_config_from_values(chat_id.as_deref(), minimum.as_deref())
+}
+
+fn format_herdr_completion_duration(duration: std::time::Duration) -> String {
+    let seconds = duration.as_secs();
+    let hours = seconds / 3600;
+    let minutes = (seconds % 3600) / 60;
+    let seconds = seconds % 60;
+    if hours > 0 {
+        format!("{hours}시간 {minutes}분 {seconds}초")
+    } else if minutes > 0 {
+        format!("{minutes}분 {seconds}초")
+    } else {
+        format!("{seconds}초")
+    }
+}
+
+fn should_send_herdr_completion(
+    duration: std::time::Duration,
+    minimum_duration: std::time::Duration,
+) -> bool {
+    duration >= minimum_duration
+}
+
+async fn herdr_completion_watcher(bot: Bot, state: SharedState, config: HerdrCompletionConfig) {
+    let mut cycle = HerdrCompletionCycle::default();
+    let mut interval = tokio::time::interval(std::time::Duration::from_secs(
+        HERDR_COMPLETION_POLL_SECONDS,
+    ));
+    interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+
+    loop {
+        interval.tick().await;
+        let model = {
+            let data = state.lock().await;
+            get_model(&data.settings, config.chat_id)
+        };
+        if !herdr::is_herdr_model(model.as_deref()) {
+            cycle = HerdrCompletionCycle::default();
+            continue;
+        }
+        let Ok(target) = herdr::target_from_model(model.as_deref()) else {
+            cycle = HerdrCompletionCycle::default();
+            continue;
+        };
+        let status_target = target.clone();
+        let status =
+            match tokio::task::spawn_blocking(move || herdr::agent_status(&status_target)).await {
+                Ok(Ok(status)) => status,
+                Ok(Err(error)) => {
+                    msg_debug(&format!(
+                        "[herdr-completion] failed to read {target} status: {error}"
+                    ));
+                    continue;
+                }
+                Err(error) => {
+                    msg_debug(&format!(
+                        "[herdr-completion] status task failed for {target}: {error}"
+                    ));
+                    continue;
+                }
+            };
+        let completion = cycle.observe(
+            &target,
+            &status,
+            herdr::is_cokacdir_prompt_active(&target),
+            std::time::Instant::now(),
+        );
+        let Some((duration, cokacdir_owned)) = completion else {
+            continue;
+        };
+        if !should_send_herdr_completion(duration, config.minimum_duration) {
+            msg_debug(&format!(
+                "[herdr-completion] suppressed {target}: short task ({:.1}s)",
+                duration.as_secs_f64()
+            ));
+            continue;
+        }
+
+        let preview = if cokacdir_owned {
+            String::new()
+        } else {
+            let preview_target = target.clone();
+            tokio::task::spawn_blocking(move || herdr::completion_preview(&preview_target))
+                .await
+                .ok()
+                .and_then(Result::ok)
+                .unwrap_or_default()
+        };
+        let mut message = format!(
+            "✅ Herdr 작업 완료\n에이전트: {target}\n소요: {}",
+            format_herdr_completion_duration(duration)
+        );
+        if !preview.trim().is_empty() {
+            message.push_str("\n\n최근 결과:\n");
+            message.push_str(preview.trim());
+        }
+        shared_rate_limit_wait(&state, config.chat_id).await;
+        if let Err(error) = tg!(
+            "send_message",
+            bot.send_message(config.chat_id, message)
+                .reply_markup(herdr_screen_keyboard())
+                .await
+        ) {
+            msg_debug(&format!(
+                "[herdr-completion] failed to notify {target}: {}",
+                redact_err(&error)
+            ));
+        }
+    }
+}
