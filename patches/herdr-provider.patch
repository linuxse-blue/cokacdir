+async fn send_herdr_screen(bot: &Bot, chat_id: ChatId, state: &SharedState) -> ResponseResult<()> {
+    let model = {
+        let data = state.lock().await;
+        get_model(&data.settings, chat_id)
+    };
+    if !herdr::is_herdr_model(model.as_deref()) {
+        shared_rate_limit_wait(state, chat_id).await;
+        tg!(
+            "send_message",
+            bot.send_message(
+                chat_id,
+                "현재 모델이 Herdr가 아닙니다. 먼저 /model herdr:<agent-name>으로 선택하세요.",
+            )
+            .await
+        )?;
+        return Ok(());
+    }
+
+    let result = tokio::task::spawn_blocking(move || herdr::read_screen(model.as_deref())).await;
+    let body = match result {
+        Ok(Ok((target, screen))) => {
+            let screen = if screen.is_empty() {
+                "(현재 화면에 출력이 없습니다.)".to_string()
+            } else {
+                screen
+            };
+            format!(
+                "<b>Herdr 화면 · {}</b>\n<pre>{}</pre>",
+                html_escape(&target),
+                html_escape(&screen)
+            )
+        }
+        Ok(Err(error)) => format!("Herdr 화면을 읽지 못했습니다: {}", html_escape(&error)),
+        Err(error) => format!(
+            "Herdr 화면 조회 작업이 중단되었습니다: {}",
+            html_escape(&error.to_string())
+        ),
+    };
+    send_long_message(bot, chat_id, &body, Some(ParseMode::Html), state).await
+}
+
+async fn handle_herdr_screen_callback(
+    bot: &Bot,
+    query: CallbackQuery,
+    state: &SharedState,
+) -> ResponseResult<()> {
+    let callback_id = query.id.clone();
+    let Some(message) = query.message.as_ref() else {
+        let _ = tg!(
+            "answer_callback_query",
+            bot.answer_callback_query(callback_id)
+                .text("이 화면 보기 버튼을 처리할 수 없습니다.")
+                .await
+        );
+        return Ok(());
+    };
+    let chat_id = message.chat().id;
+    let is_owner = {
+        let data = state.lock().await;
+        data.settings.owner_user_id == Some(query.from.id.0)
+    };
+    if !is_owner {
+        let _ = tg!(
+            "answer_callback_query",
+            bot.answer_callback_query(callback_id)
+                .text("봇 소유자만 화면을 볼 수 있습니다.")
+                .show_alert(true)
+                .await
+        );
+        return Ok(());
+    }
+
+    let _ = tg!(
+        "answer_callback_query",
+        bot.answer_callback_query(callback_id)
+            .text("화면을 불러옵니다.")
+            .await
+    );
+    send_herdr_screen(bot, chat_id, state).await
+}
