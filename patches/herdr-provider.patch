+#[cfg(test)]
+mod herdr_completion_tests {
+    use super::*;
+
+    #[test]
+    fn completion_notifications_are_disabled_without_chat_id() {
+        assert_eq!(
+            herdr_completion_config_from_values(None, Some("300")),
+            Ok(None)
+        );
+        assert!(herdr_completion_config_from_values(Some("0"), Some("300")).is_err());
+        assert!(herdr_completion_config_from_values(Some("42"), Some("invalid")).is_err());
+    }
+
+    #[test]
+    fn completion_configuration_accepts_private_and_group_chats() {
+        let private = herdr_completion_config_from_values(Some("42"), None)
+            .unwrap()
+            .unwrap();
+        assert_eq!(private.chat_id, ChatId(42));
+        assert_eq!(private.minimum_duration.as_secs(), 300);
+
+        let group = herdr_completion_config_from_values(Some("-42"), Some("0"))
+            .unwrap()
+            .unwrap();
+        assert_eq!(group.chat_id, ChatId(-42));
+        assert_eq!(group.minimum_duration.as_secs(), 0);
+    }
+
+    #[test]
+    fn completion_cycle_tracks_duration_and_cokacdir_ownership() {
+        let started = std::time::Instant::now();
+        let mut cycle = HerdrCompletionCycle::default();
+        assert_eq!(cycle.observe("worker", "idle", false, started), None);
+        assert_eq!(cycle.observe("worker", "working", false, started), None);
+        assert_eq!(
+            cycle.observe(
+                "worker",
+                "working",
+                true,
+                started + std::time::Duration::from_secs(10)
+            ),
+            None
+        );
+        assert_eq!(
+            cycle.observe(
+                "worker",
+                "blocked",
+                false,
+                started + std::time::Duration::from_secs(20)
+            ),
+            None
+        );
+        assert_eq!(
+            cycle.observe(
+                "worker",
+                "done",
+                false,
+                started + std::time::Duration::from_secs(30)
+            ),
+            None
+        );
+        assert_eq!(
+            cycle.observe(
+                "worker",
+                "done",
+                false,
+                started + std::time::Duration::from_secs(36)
+            ),
+            Some((std::time::Duration::from_secs(36), true))
+        );
+    }
+
+    #[test]
+    fn completion_cycle_resets_when_target_changes() {
+        let started = std::time::Instant::now();
+        let mut cycle = HerdrCompletionCycle::default();
+        cycle.observe("first", "working", false, started);
+        assert_eq!(
+            cycle.observe(
+                "second",
+                "idle",
+                false,
+                started + std::time::Duration::from_secs(60)
+            ),
+            None
+        );
+    }
+
+    #[test]
+    fn completion_policy_suppresses_only_short_work() {
+        let minimum = std::time::Duration::from_secs(300);
+        assert!(!should_send_herdr_completion(
+            std::time::Duration::from_secs(299),
+            minimum
+        ));
+        assert!(should_send_herdr_completion(
+            std::time::Duration::from_secs(301),
+            minimum
+        ));
+        assert!(should_send_herdr_completion(
+            std::time::Duration::from_secs(300),
+            minimum
+        ));
+    }
+}
 
