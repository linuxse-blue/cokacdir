# Telegram bot tokens (leave empty when the corresponding bot is not used)
COKACDIR_BOT_TOKEN=

# Optional: notify this Telegram chat when the selected Herdr agent finishes
# a local task that ran for at least the configured number of seconds.
# Leave the chat ID empty to disable this Cokacdir watcher. Do not enable it
# together with another Herdr completion watcher.
COKAC_HERDR_COMPLETION_NOTIFY_CHAT_ID=
COKAC_HERDR_COMPLETION_NOTIFY_MIN_S=300

# Optional LLM provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Browser live view
# Keep this default for local-only access. For LAN access, replace it with the
# Docker host's reachable address and set NOVNC_PASSWORD.
NOVNC_BIND_ADDRESS=127.0.0.1
NOVNC_PORT=7903
NOVNC_PASSWORD=

BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080
BROWSER_ENABLE_WEBGL=1
TZ=Asia/Seoul
